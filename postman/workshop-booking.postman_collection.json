      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"user_token\", pm.response.json().token);",
              "pm.test(\"Роль user\", () => pm.expect(pm.response.json().user.role).to.eql(\"user\"));"
            ]
          }
        }
      ]
    },
