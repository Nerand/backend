  "item": [
    {
      "name": "01 Регистрация участника",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{run_user}}\", \"password\": \"{{user_password}}\", \"role\": \"admin\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const run = Date.now() + \"_\" + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set(\"run_user\", \"member_\" + run);",
              "pm.collectionVariables.set(\"other_user\", \"other_\" + run);",
              "pm.collectionVariables.set(\"future\", new Date(Date.now() + 864000000).toISOString());",
              "pm.collectionVariables.set(\"past\", new Date(Date.now() - 86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Пароль скрыт\", () => pm.expect(pm.response.json()).not.to.have.property(\"password\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Вход участника",
